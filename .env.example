SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Same custom app as the web project (dev.shopify.com) — used to read
# webshop orders for the Webshop-ordrar tool.
SHOPIFY_STORE_DOMAIN=your-shop-name.myshopify.com
SHOPIFY_ADMIN_CLIENT_ID=your_admin_client_id
SHOPIFY_ADMIN_CLIENT_SECRET=your_admin_client_secret

# Random 32+ char secret used to encrypt session cookies. Generate with:
# openssl rand -base64 32
NUXT_SESSION_PASSWORD=
